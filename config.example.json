{
  "listen": "127.0.0.1:8787",
  "local_key": "",
  "lane": "v2",
  "upstream": "https://opencode.ai/inference",
  "upstream_mode": "catalog",
  "api_key": "",
  "direct": true,
  "proxies": [
    "http://user:pass@host:port",
    "http://user:pass@rotating-host:80#pool"
  ],
  "free_only": true,
  "probe_on_start": true,
  "probe_concurrency": 1,
  "probe_timeout_seconds": 30,
  "probe_interval_ms": 700,
  "cache_enabled": true,
  "cache_ttl_seconds": 1800,
  "cache_max_entries": 500,
  "catalog_refresh_minutes": 10,
  "request_timeout_seconds": 0,
  "max_attempts": 0,
  "block_seconds": 900,
  "quota_seconds": 60,
  "reasoning_effort": "",
  "debug": false
}
